# ============================================================
# Ionik — Nginx config con Cloudflare Proxy (Full Strict SSL)
# /etc/nginx/sites-available/ionik
#
# Topología:
#   Usuario → Cloudflare (HTTPS) → Nginx (HTTPS/443) → archivos
#
# SSL: Cloudflare Origin Certificate (gratuito, 15 años)
#   Generado en: Cloudflare → SSL/TLS → Origin Server → Create Certificate
#   Guardar en servidor:
#     /etc/ssl/cloudflare/ionik.cl.pem   ← Certificate
#     /etc/ssl/cloudflare/ionik.cl.key   ← Private Key
#
# Cloudflare maneja (configurar en dashboard):
#   - HTTP → HTTPS: SSL/TLS → Edge Certificates → Always Use HTTPS ✅
#   - www → non-www: Rules → Redirect Rules (ver instrucciones abajo)
# ============================================================

# --- Fallback HTTP: redirige a HTTPS (por si alguien llega sin Cloudflare) ---
server {
    listen 80;
    listen [::]:80;
    server_name ionik.cl www.ionik.cl;

    return 301 https://ionik.cl$request_uri;
}

# --- Fallback HTTPS www (bypass Cloudflare directo al servidor) ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.ionik.cl;

    ssl_certificate     /etc/ssl/cloudflare/ionik.cl.pem;
    ssl_certificate_key /etc/ssl/cloudflare/ionik.cl.key;

    return 301 https://ionik.cl$request_uri;
}

# --- Sitio principal HTTPS ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ionik.cl;

    # Cloudflare Origin Certificate
    ssl_certificate     /etc/ssl/cloudflare/ionik.cl.pem;
    ssl_certificate_key /etc/ssl/cloudflare/ionik.cl.key;

    # Protocolos seguros
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Ruta del sitio en el servidor
    root /var/www/ionikcl;
    index index.html;

    # IP real del visitante (Cloudflare la envía en este header)
    real_ip_header CF-Connecting-IP;

    # Seguridad
    server_tokens off;
    add_header X-Frame-Options        "SAMEORIGIN"  always;
    add_header X-Content-Type-Options "nosniff"     always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    # Cache de assets estáticos
    location ~* \.(webp|jpg|jpeg|png|gif|svg|ico|woff2|woff|ttf|otf)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    location ~* \.(css|js)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    # SPA: todas las rutas sirven index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Bloquear archivos ocultos (.git, .env, etc.)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    access_log /var/log/nginx/ionik.cl.access.log;
    error_log  /var/log/nginx/ionik.cl.error.log;
}
