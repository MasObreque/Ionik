-- Trigger para actualizar UPDATED_AT automáticamente
CREATE OR REPLACE TRIGGER TRG_PRODUCTS_UPDATE
BEFORE UPDATE ON PRODUCTS
FOR EACH ROW
BEGIN
    :NEW.UPDATED_AT := CURRENT_TIMESTAMP;
END;
/

CREATE OR REPLACE TRIGGER TRG_ORDERS_UPDATE
BEFORE UPDATE ON ORDERS
FOR EACH ROW
BEGIN
    :NEW.UPDATED_AT := CURRENT_TIMESTAMP;
END;
/

CREATE OR REPLACE TRIGGER TRG_CUSTOMERS_UPDATE
BEFORE UPDATE ON CUSTOMERS
FOR EACH ROW
BEGIN
    :NEW.UPDATED_AT := CURRENT_TIMESTAMP;
END;
/

-- Trigger para actualizar rating promedio del producto
CREATE OR REPLACE TRIGGER TRG_UPDATE_PRODUCT_RATING
AFTER INSERT OR UPDATE OR DELETE ON REVIEWS
FOR EACH ROW
DECLARE
    v_product_id VARCHAR2(50);
    v_avg_rating NUMBER;
    v_review_count NUMBER;
BEGIN
    IF INSERTING OR UPDATING THEN
        v_product_id := :NEW.PRODUCT_ID;
    ELSE
        v_product_id := :OLD.PRODUCT_ID;
    END IF;
    
    SELECT AVG(RATING), COUNT(*)
    INTO v_avg_rating, v_review_count
    FROM REVIEWS
    WHERE PRODUCT_ID = v_product_id AND STATUS = 'approved';
    
    UPDATE PRODUCTS
    SET RATING = NVL(v_avg_rating, 0),
        REVIEWS = v_review_count
    WHERE ID = v_product_id;
END;
/

-- Trigger para registrar cambios de inventario
CREATE OR REPLACE TRIGGER TRG_INVENTORY_CHANGE
AFTER UPDATE OF STOCK ON PRODUCTS
FOR EACH ROW
WHEN (OLD.STOCK != NEW.STOCK)
BEGIN
    INSERT INTO INVENTORY_HISTORY (
        ID, PRODUCT_ID, PREVIOUS_STOCK, NEW_STOCK, 
        CHANGE_TYPE, CREATED_AT
    ) VALUES (
        'INV_' || TO_CHAR(SYSTIMESTAMP, 'YYYYMMDDHH24MISSFF'),
        :NEW.ID,
        :OLD.STOCK,
        :NEW.STOCK,
        'adjustment',
        CURRENT_TIMESTAMP
    );
END;
/

