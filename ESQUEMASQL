-- ================================
-- PROCEDIMIENTOS ALMACENADOS
-- ================================

-- Procedimiento para procesar una orden
CREATE OR REPLACE PROCEDURE SP_PROCESS_ORDER(
    p_order_id IN VARCHAR2,
    p_status OUT VARCHAR2,
    p_message OUT VARCHAR2
) AS
    v_count NUMBER;
BEGIN
    -- Verificar que la orden existe
    SELECT COUNT(*) INTO v_count FROM ORDERS WHERE ID = p_order_id;
    
    IF v_count = 0 THEN
        p_status := 'ERROR';
        p_message := 'Orden no encontrada';
        RETURN;
    END IF;
    
    -- Actualizar stock de productos
    FOR item IN (SELECT PRODUCT_ID, QUANTITY FROM ORDER_ITEMS WHERE ORDER_ID = p_order_id) LOOP
        UPDATE PRODUCTS 
        SET STOCK = STOCK - item.QUANTITY 
        WHERE ID = item.PRODUCT_ID;
    END LOOP;
    
    -- Actualizar estado de la orden
    UPDATE ORDERS 
    SET STATUS = 'processing', UPDATED_AT = CURRENT_TIMESTAMP 
    WHERE ID = p_order_id;
    
    COMMIT;
    
    p_status := 'SUCCESS';
    p_message := 'Orden procesada exitosamente';
EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        p_status := 'ERROR';
        p_message := SQLERRM;
END;
/