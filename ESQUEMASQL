-- ================================
-- ESQUEMA DE BASE DE DATOS IONIK
-- Oracle Cloud Database
-- ================================

-- Tabla de Productos
CREATE TABLE PRODUCTS (
    ID VARCHAR2(50) PRIMARY KEY,
    NAME VARCHAR2(200) NOT NULL,
    DESCRIPTION VARCHAR2(1000),
    PRICE NUMBER(10,2) NOT NULL,
    ORIGINAL_PRICE NUMBER(10,2),
    CATEGORY VARCHAR2(50) NOT NULL,
    STOCK NUMBER(10) DEFAULT 0,
    RATING NUMBER(3,1) DEFAULT 0,
    REVIEWS NUMBER(10) DEFAULT 0,
    FEATURED NUMBER(1) DEFAULT 0,
    BADGE VARCHAR2(50),
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Índices para Productos
CREATE INDEX IDX_PRODUCTS_CATEGORY ON PRODUCTS(CATEGORY);
CREATE INDEX IDX_PRODUCTS_FEATURED ON PRODUCTS(FEATURED);
CREATE INDEX IDX_PRODUCTS_STOCK ON PRODUCTS(STOCK);

-- Tabla de Imágenes de Productos
CREATE TABLE PRODUCT_IMAGES (
    ID VARCHAR2(50) PRIMARY KEY,
    PRODUCT_ID VARCHAR2(50) NOT NULL,
    IMAGE_URL VARCHAR2(500) NOT NULL,
    IMAGE_ORDER NUMBER(3) DEFAULT 0,
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT FK_IMAGES_PRODUCT FOREIGN KEY (PRODUCT_ID) 
        REFERENCES PRODUCTS(ID) ON DELETE CASCADE
);

-- Índice para Imágenes
CREATE INDEX IDX_IMAGES_PRODUCT ON PRODUCT_IMAGES(PRODUCT_ID);

-- Tabla de Órdenes
CREATE TABLE ORDERS (
    ID VARCHAR2(50) PRIMARY KEY,
    CUSTOMER_EMAIL VARCHAR2(200) NOT NULL,
    CUSTOMER_NAME VARCHAR2(200) NOT NULL,
    CUSTOMER_PHONE VARCHAR2(50),
    SHIPPING_ADDRESS VARCHAR2(500),
    SHIPPING_CITY VARCHAR2(100),
    SHIPPING_REGION VARCHAR2(100),
    TOTAL NUMBER(10,2) NOT NULL,
    DISCOUNT NUMBER(10,2) DEFAULT 0,
    SHIPPING_COST NUMBER(10,2) DEFAULT 0,
    STATUS VARCHAR2(50) DEFAULT 'pending',
    PAYMENT_METHOD VARCHAR2(50),
    PAYMENT_STATUS VARCHAR2(50) DEFAULT 'pending',
    TRACKING_NUMBER VARCHAR2(100),
    NOTES VARCHAR2(1000),
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Índices para Órdenes
CREATE INDEX IDX_ORDERS_EMAIL ON ORDERS(CUSTOMER_EMAIL);
CREATE INDEX IDX_ORDERS_STATUS ON ORDERS(STATUS);
CREATE INDEX IDX_ORDERS_DATE ON ORDERS(CREATED_AT);

-- Tabla de Items de Órdenes
CREATE TABLE ORDER_ITEMS (
    ID VARCHAR2(50) PRIMARY KEY,
    ORDER_ID VARCHAR2(50) NOT NULL,
    PRODUCT_ID VARCHAR2(50) NOT NULL,
    PRODUCT_NAME VARCHAR2(200) NOT NULL,
    QUANTITY NUMBER(10) NOT NULL,
    PRICE NUMBER(10,2) NOT NULL,
    SUBTOTAL NUMBER(10,2) NOT NULL,
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT FK_ITEMS_ORDER FOREIGN KEY (ORDER_ID) 
        REFERENCES ORDERS(ID) ON DELETE CASCADE,
    CONSTRAINT FK_ITEMS_PRODUCT FOREIGN KEY (PRODUCT_ID) 
        REFERENCES PRODUCTS(ID)
);

-- Índice para Items
CREATE INDEX IDX_ITEMS_ORDER ON ORDER_ITEMS(ORDER_ID);

-- Tabla de Clientes
CREATE TABLE CUSTOMERS (
    ID VARCHAR2(50) PRIMARY KEY,
    EMAIL VARCHAR2(200) UNIQUE NOT NULL,
    NAME VARCHAR2(200) NOT NULL,
    PHONE VARCHAR2(50),
    ADDRESS VARCHAR2(500),
    CITY VARCHAR2(100),
    REGION VARCHAR2(100),
    POSTAL_CODE VARCHAR2(20),
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Índice para Clientes
CREATE INDEX IDX_CUSTOMERS_EMAIL ON CUSTOMERS(EMAIL);

-- Tabla de Reseñas
CREATE TABLE REVIEWS (
    ID VARCHAR2(50) PRIMARY KEY,
    PRODUCT_ID VARCHAR2(50) NOT NULL,
    CUSTOMER_EMAIL VARCHAR2(200) NOT NULL,
    CUSTOMER_NAME VARCHAR2(200) NOT NULL,
    RATING NUMBER(1) NOT NULL CHECK (RATING >= 1 AND RATING <= 5),
    TITLE VARCHAR2(200),
    COMMENT VARCHAR2(1000),
    VERIFIED_PURCHASE NUMBER(1) DEFAULT 0,
    HELPFUL_COUNT NUMBER(10) DEFAULT 0,
    STATUS VARCHAR2(20) DEFAULT 'pending',
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT FK_REVIEWS_PRODUCT FOREIGN KEY (PRODUCT_ID) 
        REFERENCES PRODUCTS(ID) ON DELETE CASCADE
);

-- Índices para Reseñas
CREATE INDEX IDX_REVIEWS_PRODUCT ON REVIEWS(PRODUCT_ID);
CREATE INDEX IDX_REVIEWS_STATUS ON REVIEWS(STATUS);

-- Tabla de Categorías
CREATE TABLE CATEGORIES (
    ID VARCHAR2(50) PRIMARY KEY,
    NAME VARCHAR2(100) UNIQUE NOT NULL,
    DESCRIPTION VARCHAR2(500),
    IMAGE_URL VARCHAR2(500),
    DISPLAY_ORDER NUMBER(5) DEFAULT 0,
    ACTIVE NUMBER(1) DEFAULT 1,
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabla de Códigos de Descuento
CREATE TABLE DISCOUNT_CODES (
    ID VARCHAR2(50) PRIMARY KEY,
    CODE VARCHAR2(50) UNIQUE NOT NULL,
    DESCRIPTION VARCHAR2(200),
    DISCOUNT_TYPE VARCHAR2(20) NOT NULL, -- 'percentage' o 'fixed'
    DISCOUNT_VALUE NUMBER(10,2) NOT NULL,
    MIN_PURCHASE NUMBER(10,2),
    MAX_DISCOUNT NUMBER(10,2),
    USAGE_LIMIT NUMBER(10),
    USAGE_COUNT NUMBER(10) DEFAULT 0,
    VALID_FROM TIMESTAMP,
    VALID_UNTIL TIMESTAMP,
    ACTIVE NUMBER(1) DEFAULT 1,
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Índice para Códigos
CREATE INDEX IDX_DISCOUNT_CODE ON DISCOUNT_CODES(CODE);

-- Tabla de Transacciones de Pago
CREATE TABLE PAYMENT_TRANSACTIONS (
    ID VARCHAR2(50) PRIMARY KEY,
    ORDER_ID VARCHAR2(50) NOT NULL,
    PAYMENT_METHOD VARCHAR2(50) NOT NULL,
    AMOUNT NUMBER(10,2) NOT NULL,
    CURRENCY VARCHAR2(10) DEFAULT 'CLP',
    STATUS VARCHAR2(50) DEFAULT 'pending',
    TRANSACTION_ID VARCHAR2(200),
    GATEWAY_RESPONSE CLOB,
    ERROR_MESSAGE VARCHAR2(500),
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT FK_PAYMENT_ORDER FOREIGN KEY (ORDER_ID) 
        REFERENCES ORDERS(ID) ON DELETE CASCADE
);

-- Índice para Transacciones
CREATE INDEX IDX_TRANSACTIONS_ORDER ON PAYMENT_TRANSACTIONS(ORDER_ID);

-- Tabla de Configuración del Sitio
CREATE TABLE SITE_CONFIG (
    KEY VARCHAR2(100) PRIMARY KEY,
    VALUE VARCHAR2(1000),
    DESCRIPTION VARCHAR2(500),
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabla de Inventario (Historial)
CREATE TABLE INVENTORY_HISTORY (
    ID VARCHAR2(50) PRIMARY KEY,
    PRODUCT_ID VARCHAR2(50) NOT NULL,
    PREVIOUS_STOCK NUMBER(10),
    NEW_STOCK NUMBER(10),
    CHANGE_TYPE VARCHAR2(50), -- 'sale', 'restock', 'adjustment'
    REFERENCE_ID VARCHAR2(50), -- ORDER_ID si es venta
    NOTES VARCHAR2(500),
    CREATED_BY VARCHAR2(100),
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT FK_INVENTORY_PRODUCT FOREIGN KEY (PRODUCT_ID) 
        REFERENCES PRODUCTS(ID)
);

-- Índice para Historial de Inventario
CREATE INDEX IDX_INVENTORY_PRODUCT ON INVENTORY_HISTORY(PRODUCT_ID);
CREATE INDEX IDX_INVENTORY_DATE ON INVENTORY_HISTORY(CREATED_AT);

